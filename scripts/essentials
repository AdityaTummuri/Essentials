#!/usr/bin/env bash
# Essentials CLI: Universal AI Developer Toolkit launcher
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "error: python3 is required to run Essentials CLI" >&2
  exit 2
fi

exec python3 -I "$here/essentials_cli.py" "$@"
